{
  "name": "toskill",
  "version": "0.1.3",
  "description": "Turn any repository into an agent skill: digest the docs, lint the SKILL.md, prepare the upstream PR. Static, local, no dependencies.",
  "bin": {
    "toskill": "./cli.js"
  },
  "files": [
    "cli.js",
    "frontmatter.js",
    "digest.js",
    "lint.js",
    "pr.js",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples/demo-tool/"
  ],
  "scripts": {
    "test": "node --test",
    "verify:pack": "node scripts/verify-pack.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/provenwork/toskill.git"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "claude-code",
    "codex",
    "cursor",
    "ai-agents",
    "cli"
  ],
  "author": "Ronald Nyami (https://github.com/provenwork)",
  "license": "MIT"
}
